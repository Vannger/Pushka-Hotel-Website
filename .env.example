# Copy to .env and fill in. Never commit the real .env file.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DJANGO_CSRF_TRUSTED_ORIGINS=https://pushka-hotel.ru

# PostgreSQL. Leave POSTGRES_DB empty to use a local SQLite file instead.
POSTGRES_DB=pushka
POSTGRES_USER=pushka
POSTGRES_PASSWORD=pushka
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
